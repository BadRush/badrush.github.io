# ====================================================================
# Environment Configuration for VM & Cloudflare Tunnel Deployment
# ====================================================================

# Cloudflare Tunnel Connector Token
# Dapatkan dari Cloudflare Zero Trust Dashboard:
# Networks -> Tunnels -> (Pilih Tunnel) -> Install connector (Docker) -> Salin string token setelah --token
TUNNEL_TOKEN=eyJh...

# Port loopback lokal host VM (opsional untuk testing langsung via curl/browser lokal)
PORT=4601
